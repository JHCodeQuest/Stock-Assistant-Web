PORT=5000
FRONTEND_URL=https://jhcodequest.github.io

# Required. The only database setting the code reads. Without it the API starts but
# /api/health reports "not configured" and data routes return 503.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: force TLS on or off (default: on for render.com, neon.tech, supabase.co and sslmode=require)
# DATABASE_SSL=true

JWT_SECRET=your-jwt-secret-key-change-this-in-production
RESEND_API_KEY=re_your_api_key_here

# Required for persistent image uploads in production. Backend only; never REACT_APP_*.
# Get these from your Cloudinary product environment's API keys settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
